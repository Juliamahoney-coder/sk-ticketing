# Real Supabase values for `npm run migrate:prod`. Copy this file to
# .env.production.local and fill in the placeholders below — that file is
# gitignored and never touched by local dev (`npm run dev`, `prisma migrate
# dev`, etc.), which keeps reading .env as before.
#
# DATABASE_URL = Supabase Transaction Pooler connection string (app runtime)
# DIRECT_URL   = Supabase Direct connection string (used by migrate:prod)
DATABASE_URL=replace-with-your-supabase-pooled-connection-string
DIRECT_URL=replace-with-your-supabase-direct-connection-string

# Supabase Storage (comment attachments) — see Project Settings > API
SUPABASE_URL=replace-with-your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=ticket-attachments
