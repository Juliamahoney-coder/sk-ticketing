DATABASE_URL="postgresql://ticketing:ticketing@localhost:5432/ticketing?schema=public"
# Local Docker Postgres has no separate pooler, so direct == pooled here.
# In Supabase: DATABASE_URL = Transaction Pooler connection string,
# DIRECT_URL = Direct connection string (used only for migrations).
DIRECT_URL="postgresql://ticketing:ticketing@localhost:5432/ticketing?schema=public"

# Generate your own with `openssl rand -base64 32` — never reuse this placeholder
NEXTAUTH_SECRET=replace-with-generated-secret
NEXTAUTH_URL="http://localhost:3000"
